{
  "name": "oauth-pkce-demo",
  "version": "1.0.0",
  "description": "OAuth 2.0 authorization code flow with PKCE — runs in any browser, works with any compliant server",
  "main": "dist/server.js",
  "scripts": {
    "build:server": "tsc --project tsconfig.json",
    "build:browser": "tsc --project tsconfig.browser.json",
    "build": "npm run build:server && npm run build:browser",
    "start": "npm run build && node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build:gh-pages": "npm run build:browser && node scripts/build-gh-pages.js",
    "deploy:gh-pages": "npm run build:gh-pages && npx --yes gh-pages -d dist-pages"
  },
  "keywords": ["oauth2", "pkce", "authorization-code-flow", "typescript"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
