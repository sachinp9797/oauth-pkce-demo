# Xola OAuth Server Configuration
XOLA_URL=http://localhost
XOLA_OAUTH_AUTHORIZE_URL=http://localhost/oauth/login
XOLA_OAUTH_TOKEN_URL=http://localhost/oauth2/token
XOLA_OAUTH_USERINFO_URL=http://localhost/api/oauth/userinfo

# OAuth Client Credentials
# Get these by running: curl -X POST http://localhost/api/oauth/register \
#   -H 'Content-Type: application/json' \
#   -d '{"client_name":"Sample App","redirect_uris":["http://localhost:8080/callback"],"grant_types":["authorization_code"]}'
OAUTH_CLIENT_ID=your_client_id_here
OAUTH_CLIENT_SECRET=your_client_secret_here

# App Configuration
REDIRECT_URI=http://localhost:8080/callback
SESSION_SECRET=change_this_to_a_random_string_in_production
PORT=8080
