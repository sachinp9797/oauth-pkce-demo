# OAuth Server endpoints (any RFC 6749-compliant provider)
OAUTH_AUTHORIZE_URL=https://your-provider.example.com/oauth/authorize
OAUTH_TOKEN_URL=https://your-provider.example.com/oauth/token
OAUTH_USERINFO_URL=https://your-provider.example.com/oauth/userinfo

# CIMD mode: set NGROK_URL to your ngrok HTTPS tunnel (e.g. https://abc123.ngrok-free.app).
# When set, OAUTH_CLIENT_ID is ignored — the client_id becomes the metadata URL.
NGROK_URL=

# Static client mode (used when NGROK_URL is not set)
OAUTH_CLIENT_ID=your_client_id_here

# App configuration
# REDIRECT_URI is auto-derived from NGROK_URL in CIMD mode.
REDIRECT_URI=http://localhost:8080/callback
PUBLIC_BASE_URL=
SESSION_SECRET=change_this_to_a_random_string_in_production
PORT=8080
